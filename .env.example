# ============================================================
# SmartPlant environment configuration (copy to .env and adjust)
# NEVER commit a real .env file. All secrets here are demo defaults.
# ============================================================

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Data ---
# SQLite is the default embedded database (zero-dependency demo deployment).
# The repository layer is isolated so PostgreSQL can be swapped in for
# production (see docs/ARCHITECTURE.md — "Database swap").
DB_PATH=./data/smartplant.db
#
# MODE A — demo (default): sample data is seeded on an empty DB.
DEMO_MODE=true
SEED_DEMO_DATA=true
#
# MODE B — NO DEMO DATA (production-like): nothing is seeded. Everything is
# generated from the data YOU create: register the first account (becomes
# ADMIN), add machines (manually or "generate a plant" with the AI Copilot),
# and send real telemetry via the Telemetry page. Insights, alerts, answers
# and reports are then produced by the AI engine from that live data.
#   DEMO_MODE=false
#   SEED_DEMO_DATA=false
#   ALLOW_REGISTRATION=true   # first account = ADMIN; later = WORKER.
#                             # Set false after onboarding to lock sign-ups.
#   SIMULATE_TELEMETRY=false  # readings come solely from real ingestion
#
#   Then delete data/smartplant.db (or point DB_PATH elsewhere) and restart.

# --- Auth ---
# Generate a long random value for production:  openssl rand -hex 48
JWT_SECRET=change-me-in-production-please-32chars-minimum
JWT_TTL_HOURS=12
ALLOW_REGISTRATION=true     # first account on an empty DB = ADMIN,
                            # later accounts = WORKER (promote in Admin)
LOGIN_RATE_LIMIT=10         # failed attempts per email+IP per window
LOGIN_RATE_WINDOW_MIN=15

# --- Telemetry / Simulator ---
SIMULATE_TELEMETRY=true     # synthetic telemetry generator (source=simulator)
SIM_INTERVAL_SEC=30         # simulator tick
TELEMETRY_STALE_MIN=5       # RUNNING machine without readings → MACHINE_OFFLINE alert

# --- Alerts (defaults; per-machine thresholds live in DB) ---
ALERT_TEMP_MAX_C=60
ALERT_POWER_MAX_KW=12

# --- Energy / cost ---
TARIFF_USD_PER_KWH=0.12

# --- AI ---
# AI_MODE: auto | anthropic | openai | fallback
#   auto     → use provider if a key is present, otherwise deterministic fallback
#   fallback → deterministic, fully grounded rule engine (works offline, no keys)
AI_MODE=auto

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---------------------------------------------------------------------------
# NVIDIA NIM (recommended) — build.nvidia.com
# Get a key at https://build.nvidia.com (NVIDIA Developer → API keys).
# Set NVIDIA_API_KEY in your shell / `.env`; it is the same variable the
# official NVIDIA SDK example uses ($NVIDIA_API_KEY).
# ---------------------------------------------------------------------------
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-ai/deepseek-v4-pro-0813

# OpenAI-compatible endpoint (the adapter below also accepts the NVIDIA_*
# variables as aliases, so you only need to fill in ONE key).
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-ai/deepseek-v4-pro-0813
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# Provider-specific extra body fields (JSON), merged into every chat request.
# NVIDIA NIM DeepSeek models: {"chat_template_kwargs":{"thinking":false}}
# Not required — the backend auto-disables thinking when a NIM endpoint is set.
OPENAI_EXTRA_BODY={"chat_template_kwargs":{"thinking":false}}

# Sampling (matches the NVIDIA SDK example: temperature=1, top_p=0.95, seed=42)
AI_TEMPERATURE=1
AI_TOP_P=0.95
AI_SEED=42

# AI budget / safety
AI_MAX_TOOL_ITERATIONS=8
AI_MAX_TOKENS=16384
AI_ACTION_CONFIRM_TTL_MIN=10

# --- CORS ---
# Comma-separated allowed origins. '*' is acceptable for bearer-token APIs.
CORS_ORIGINS=*

# --- Logging ---
LOG_LEVEL=info              # trace | debug | info | warn | error
